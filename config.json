{
  "embedding_model": "johnpaulbin/bge-m3-distilled",
  "llm_provider": "ollama",
  "llm_model": "gemma3",
  "llm_url": "http://localhost:11434",
  "llm_temperature": 0.7,
  "llm_max_tokens": null,
  "chunk_size": 512,
  "chunk_overlap": 50,
  "top_k": 3,
  "chroma_collection_name": "vector_collection",
  "chroma_persist_dir": "./chroma_db",
  "chunk_mode": "text",
  "chunk_document_options": {
    "json_mode_options": {},
    "html_mode_options": {},
    "markdown_mode_options": {
      "return_each_line": false,
      "strip_headers": true
    }
  },
  "chunk_length_options": {
    "mode": "char",
    "char_mode_options": {
      "separator": "\n\n",
      "is_separator_regex": false
    },
    "token_mode_options": {
      "encoding_name": "cl100k_base"
    }
  },
  "system_prompt": "Ти си помошник кој одговара на прашања.\nКористи го САМО дадениот контекст за да одговориш на прашањето.\nАко одговорот не е во контекстот, кажи дека немаш доволно информации.\nОдговарај концизно и точно.",
  "prompt_template": "Контекст:\n{context}\n\nПрашање: {question}\n\nОдговор:",
  "embedding_device": "auto",
  "embedding_batch_size": 256,
  "normalize_embeddings": true
}
