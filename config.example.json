{
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "embedding_provider": "huggingface",
  "llm_provider": "ollama",
  "llm_model": "llama3.2:3b",
  "llm_url": "http://localhost:11434",
  "llm_temperature": 0.7,
  "llm_max_tokens": null,
  "chunk_size": 512,
  "chunk_overlap": 50,
  "top_k": 3,
  "vector_store_provider": "qdrant",
  "qdrant_collection_name": "mk_rag_collection",
  "qdrant_url": "http://localhost:6333",
  "qdrant_api_key": null,
  "qdrant_prefer_grpc": false,
  "chunk_mode": "text",
  "chunk_document_options": {
    "json_mode_options": {},
    "html_mode_options": {},
    "markdown_mode_options": {
      "return_each_line": false,
      "strip_headers": true
    }
  },
  "chunk_length_options": {
    "mode": "char",
    "char_mode_options": {
      "separator": "\n\n",
      "is_separator_regex": false
    },
    "token_mode_options": {
      "encoding_name": "cl100k_base"
    }
  },
  "embedding_device": "auto",
  "embedding_batch_size": 256,
  "normalize_embeddings": true,
  "semantic_breakpoint_type": "percentile",
  "semantic_breakpoint_amount": null,
  "mcp_enabled": true,
  "mcp_servers": {},
  "query_transform_mode": "multi_query",
  "enabled_transforms": ["multi_query"],
  "max_generated_queries": 2,
  "transform_gate_enabled": true,
  "k_per_query": 4,
  "k_total_before_rerank": 10,
  "merge_strategy": "rrf",
  "hyde_include_original_query": true,
  "query_transform_timeout_ms": 2000,
  "reranker_enabled": false,
  "reranker_model": "cross-encoder/ms-marco-MiniLM-L-12-v2",
  "reranker_top_n": 5
}
